# Sleeve Notes — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ─── Django webapp config (required for the Django port) ─────────────────────
# Public-facing brand name. Change to rebrand without touching code.
APP_NAME=Sleeve Notes

# Which environment this process is running in: local | staging | production.
# Affects Sentry tags, footer banner, logging, and staging gate middleware.
ENVIRONMENT=local

# Django secret key (signs sessions, CSRF tokens, password reset URLs). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Toggle debug mode. Always false in staging/production. true on local dev only.
DJANGO_DEBUG=true

# Comma-separated list of hostnames Django accepts. Local default is fine for dev.
# Production example: "sleeve-notes.onrender.com,sleevenotes.app"
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Trusted origins for CSRF on HTTPS endpoints (POST forms). Required by Django
# 4+ when posting from any HTTPS origin. Comma-separated, no path, include scheme.
# Local HTTP doesn't need this; staging/prod do.
# Example: "https://sleeve-notes-web-staging.onrender.com,https://sleevenotes.app"
DJANGO_CSRF_TRUSTED_ORIGINS=

# Postgres connection. Local docker-compose default below; on Render, replaced by
# DATABASE_URL injected from the managed Postgres add-on.
DATABASE_URL=postgres://sleevenotes:dev@localhost:5432/sleevenotes

# Fernet key for encrypting per-user 3rd-party credentials (Spotify tokens etc.).
# Generate locally with:
#   python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Use a different key for staging and production. Losing this = encrypted
# values become unreadable forever.
FIELD_ENCRYPTION_KEY=

# Transactional email default sender (placeholder; provider wired up in fase 1C).
DEFAULT_FROM_EMAIL=noreply@example.com

# Dev convenience: run a Django-Q2 cluster on a daemon thread inside the
# `runserver` process so the sidebar action buttons (Discogs sync, BPM lookup)
# work without a separate `manage.py qcluster` terminal. Set to false (or
# leave empty) on Render — the worker service runs its own cluster process.
DEV_INPROCESS_QCLUSTER=false

# Sentry DSN for error reporting. Empty = Sentry disabled. Get yours at
# https://sentry.io/ → your project → Settings → Client Keys (DSN).
SENTRY_DSN=

# HTTP Basic Auth credentials guarding the staging environment (only required
# when ENVIRONMENT=staging). Pick anything — username can be your name, password
# a Bitwarden-generated string. /healthz bypasses this gate so Render's health
# checker stays happy.
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_PASSWORD=

# ─── Discogs OAuth (required) ────────────────────────────────────────────────
# Register your app at https://www.discogs.com/settings/developers and set the
# callback URL to:   https://<your-host>/auth/callback
# (locally:          http://localhost:8765/auth/callback)
# Then paste the consumer credentials below.
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=

# ─── Session cookie signing (required) ───────────────────────────────────────
# Long random string used to sign/encrypt the session cookie that holds the
# logged-in user's Discogs token. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=

# Production-only: set to "true" to refuse the session cookie over plain HTTP.
# Default false is dev-friendly (localhost is HTTP).
# SESSION_HTTPS_ONLY=true

# ─── BPM-cascade infrastructure (app-wide, not per-user) ─────────────────────
# Spotify Web API — for ReccoBeats lookups (BPM/key from audio features).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Beatport — official BPM/key for dance releases.
BEATPORT_USERNAME=
BEATPORT_PASSWORD=

# YouTube Data API — lazy-resolves per-track listen links when there's no
# Spotify ID. Optional; without it, the "listen" icon falls back to a search.
YOUTUBE_API_KEY=

# ─── Standalone CLI use (optional, advanced) ─────────────────────────────────
# The web UI normally injects these four into the `sleeve-notes` subprocess via
# the job runner. For CLI-only use, paste them after logging in via the web UI
# (extract them from your session cookie) so commands like
# `sleeve-notes fetch` / `sleeve-notes bpm` know which user to read/write for.
# DISCOGS_USER_ID=
# DISCOGS_USERNAME=
# DISCOGS_OAUTH_TOKEN=
# DISCOGS_OAUTH_TOKEN_SECRET=
