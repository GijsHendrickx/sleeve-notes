# Sleeve Notes — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ─── Discogs OAuth (required) ────────────────────────────────────────────────
# Register your app at https://www.discogs.com/settings/developers and set the
# callback URL to:   https://<your-host>/auth/callback
# (locally:          http://localhost:8765/auth/callback)
# Then paste the consumer credentials below.
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=

# ─── Session cookie signing (required) ───────────────────────────────────────
# Long random string used to sign/encrypt the session cookie that holds the
# logged-in user's Discogs token. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=

# Production-only: set to "true" to refuse the session cookie over plain HTTP.
# Default false is dev-friendly (localhost is HTTP).
# SESSION_HTTPS_ONLY=true

# ─── BPM-cascade infrastructure (app-wide, not per-user) ─────────────────────
# Spotify Web API — for ReccoBeats lookups (BPM/key from audio features).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Beatport — official BPM/key for dance releases.
BEATPORT_USERNAME=
BEATPORT_PASSWORD=

# YouTube Data API — lazy-resolves per-track listen links when there's no
# Spotify ID. Optional; without it, the "listen" icon falls back to a search.
YOUTUBE_API_KEY=

# ─── Standalone CLI use (optional, advanced) ─────────────────────────────────
# The web UI normally injects these four into the `sleeve-notes` subprocess via
# the job runner. For CLI-only use, paste them after logging in via the web UI
# (extract them from your session cookie) so commands like
# `sleeve-notes fetch` / `sleeve-notes bpm` know which user to read/write for.
# DISCOGS_USER_ID=
# DISCOGS_USERNAME=
# DISCOGS_OAUTH_TOKEN=
# DISCOGS_OAUTH_TOKEN_SECRET=
